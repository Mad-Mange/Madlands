<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared between the .NET server and the Unity client. The same source files are compiled by
    Unity via package.json + Madlands.Shared.asmdef (noEngineReferences: true), so this project
    must stay within what Unity's compiler supports: netstandard2.1, C# 9, no nullable context,
    no implicit usings, no records/init (no IsExternalInit in Unity), no NuGet dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Madlands.Shared</RootNamespace>
  </PropertyGroup>

</Project>
