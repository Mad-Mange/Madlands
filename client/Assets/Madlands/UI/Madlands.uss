/* Madlands front-end and in-game menu styles. Palette: night blue panels, shard gold accents. */

.root {
    flex-grow: 1;
}

.root.frontend {
    background-color: rgb(12, 15, 24);
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.hidden {
    display: none;
}

/* ---------------------------------------------------------------- branding */

.brand {
    align-items: center;
    margin-bottom: 28px;
}

.brand-title {
    font-size: 84px;
    -unity-font-style: bold;
    color: rgb(233, 196, 106);
    letter-spacing: 14px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(70, 48, 12);
}

.brand-tagline {
    font-size: 20px;
    color: rgb(160, 172, 196);
    -unity-font-style: italic;
}

/* ---------------------------------------------------------------- panels */

.panel {
    width: 480px;
    padding: 26px;
    background-color: rgba(20, 25, 38, 0.94);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 8px;
}

.panel.wide {
    width: 680px;
}

.panel.narrow {
    width: 320px;
}

.heading {
    font-size: 30px;
    color: rgb(233, 196, 106);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.subheading {
    font-size: 15px;
    color: rgb(150, 162, 186);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.field {
    margin-top: 6px;
    margin-bottom: 6px;
}

.field .unity-base-field__label {
    min-width: 110px;
    color: rgb(212, 218, 230);
    font-size: 16px;
}

.field .unity-base-text-field__input,
.field .unity-base-popup-field__input {
    font-size: 16px;
    min-height: 30px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 16px;
}

.button {
    height: 40px;
    min-width: 128px;
    margin: 4px;
    font-size: 16px;
    color: rgb(232, 232, 238);
    background-color: rgb(50, 57, 77);
    border-width: 1px;
    border-color: rgb(88, 96, 122);
    border-radius: 4px;
}

.button:hover {
    background-color: rgb(66, 75, 100);
}

.button.primary {
    color: rgb(255, 246, 222);
    background-color: rgb(148, 108, 38);
    border-color: rgb(233, 196, 106);
    -unity-font-style: bold;
}

.button.primary:hover {
    background-color: rgb(176, 130, 50);
}

.button.danger {
    background-color: rgb(108, 40, 40);
    border-color: rgb(160, 70, 70);
}

.button.danger:hover {
    background-color: rgb(134, 52, 52);
}

/* Temporary playtest shortcut on the login screen. */
.button.quick {
    height: 30px;
    margin-top: 12px;
    font-size: 13px;
    color: rgb(170, 182, 206);
    background-color: rgba(50, 57, 77, 0.5);
    border-color: rgb(70, 78, 102);
}

.panel.narrow .button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
}

.status {
    margin-top: 12px;
    font-size: 15px;
    color: rgb(240, 138, 118);
    white-space: normal;
    -unity-text-align: middle-center;
}

.status.ok {
    color: rgb(150, 218, 150);
}

.hint {
    margin: 14px;
    color: rgb(150, 162, 186);
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- character list */

.character-list {
    min-height: 120px;
    max-height: 380px;
}

.character-entry {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-top: 3px;
    margin-bottom: 3px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

.character-entry:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.character-entry.selected {
    background-color: rgba(233, 196, 106, 0.14);
    border-color: rgb(233, 196, 106);
}

.character-name {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(242, 242, 247);
}

.character-details {
    font-size: 14px;
    color: rgb(170, 180, 202);
}

/* The level, in a round badge like the player portrait in the game. */
.character-level {
    width: 44px;
    height: 44px;
    margin-right: 14px;
    border-width: 2px;
    border-color: rgb(233, 196, 106);
    border-radius: 22px;
    background-color: rgb(40, 46, 64);
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 230, 160);
}

.character-text {
    flex-direction: column;
}

/* ---------------------------------------------------------------- footer and overlays */

.footer {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.field.small {
    width: 340px;
}

.footer-right {
    flex-direction: row;
    align-items: center;
}

.footer-right .button {
    height: 30px;
    min-width: 96px;
    font-size: 13px;
    margin-right: 12px;
}

.version {
    font-size: 12px;
    color: rgb(110, 120, 142);
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.busy-label {
    font-size: 26px;
    color: rgb(233, 196, 106);
}
