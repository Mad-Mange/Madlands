/* In-game HUD: unit frames, action bar, cast bars, auras, nameplates, combat text, chat.
   Sizes are in reference pixels (1920x1080, PanelSettings scale with screen size). */

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---------------------------------------------------------------- bars */

.bar {
    height: 18px;
    margin-top: 3px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.bar.health .bar-fill {
    background-color: rgb(46, 170, 66);
}

.bar.power .bar-fill {
    background-color: rgb(40, 96, 214);
}

.bar.power.rage .bar-fill {
    background-color: rgb(200, 36, 36);
}

.bar.power.energy .bar-fill {
    background-color: rgb(220, 196, 40);
}

.bar-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    padding: 0;
    margin: 0;
}

/* ---------------------------------------------------------------- unit frames */

.unit-frame {
    position: absolute;
    top: 18px;
    width: 300px;
    flex-direction: row;
    padding: 6px;
    background-color: rgba(14, 18, 28, 0.82);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 6px;
}

.unit-frame.player {
    left: 18px;
}

.unit-frame.target {
    left: 336px;
}

.portrait {
    width: 52px;
    height: 52px;
    margin-right: 8px;
    border-radius: 26px;
    background-color: rgb(40, 46, 64);
    border-width: 2px;
    border-color: rgb(233, 196, 106);
    align-items: center;
    justify-content: center;
}

.unit-frame.hostile .portrait {
    border-color: rgb(214, 60, 50);
}

.unit-frame.neutral .portrait {
    border-color: rgb(226, 200, 60);
}

.unit-frame.friendly .portrait {
    border-color: rgb(80, 200, 90);
}

.portrait-level {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 230, 160);
}

.frame-body {
    flex-grow: 1;
}

.frame-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    padding: 0;
    margin: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.unit-frame.hostile .frame-name {
    color: rgb(255, 120, 100);
}

.unit-frame.neutral .frame-name {
    color: rgb(255, 230, 110);
}

.unit-frame.dead .frame-name {
    color: rgb(150, 150, 150);
}

.unit-frame.combat .portrait {
    background-color: rgb(110, 30, 30);
}

/* ---------------------------------------------------------------- auras */

.aura-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 12px;
}

.player-auras {
    position: absolute;
    top: 18px;
    right: 220px;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    width: 520px;
}

.aura {
    width: 30px;
    height: 30px;
    margin: 2px;
    border-width: 1px;
    border-color: rgb(30, 160, 50);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

.aura.harmful {
    border-color: rgb(210, 40, 40);
}

.player-auras .aura {
    width: 38px;
    height: 38px;
}

.aura-time {
    position: absolute;
    bottom: -14px;
    left: -6px;
    right: -6px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(255, 240, 200);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.aura-stacks {
    position: absolute;
    right: 1px;
    bottom: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* ---------------------------------------------------------------- icons */

.icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.icon-letters {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.95);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.aura .icon-letters {
    font-size: 11px;
}

/* ---------------------------------------------------------------- action bar */

.bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    align-items: center;
}

.action-bar {
    flex-direction: row;
    padding: 5px;
    background-color: rgba(14, 18, 28, 0.82);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 6px;
}

.action-button {
    width: 56px;
    height: 56px;
    margin: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgb(88, 96, 122);
    border-radius: 4px;
}

.action-button:hover {
    border-color: rgb(255, 230, 160);
}

.action-button.empty .icon {
    display: none;
}

.action-button.unusable .icon {
    opacity: 0.35;
}

.action-button.out-of-range .icon {
    background-color: rgb(120, 30, 30);
}

/* A soft glow made of two fading rings (USS has no box-shadow): green = usable right now,
   orange = busy (cooling down, global cooldown or casting). */
.glow-inner,
.glow-outer {
    position: absolute;
    display: none;
    border-width: 2px;
}

.glow-inner {
    left: -3px;
    right: -3px;
    top: -3px;
    bottom: -3px;
    border-radius: 6px;
}

.glow-outer {
    left: -5px;
    right: -5px;
    top: -5px;
    bottom: -5px;
    border-radius: 8px;
}

.action-button.ready .glow-inner,
.action-button.ready .glow-outer,
.action-button.busy .glow-inner,
.action-button.busy .glow-outer {
    display: flex;
}

.action-button.ready {
    border-color: rgb(120, 235, 140);
}

.action-button.ready .glow-inner {
    border-color: rgba(110, 235, 130, 0.7);
}

.action-button.ready .glow-outer {
    border-color: rgba(110, 235, 130, 0.28);
}

.action-button.busy {
    border-color: rgb(240, 156, 64);
}

.action-button.busy .glow-inner {
    border-color: rgba(240, 150, 50, 0.65);
}

.action-button.busy .glow-outer {
    border-color: rgba(240, 150, 50, 0.24);
}

.action-button.active {
    border-color: rgb(255, 214, 90);
    border-width: 2px;
}

.action-key {
    position: absolute;
    left: 3px;
    top: 1px;
    font-size: 12px;
    color: rgb(220, 220, 230);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.cooldown-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    display: none;
    background-color: rgba(150, 152, 162, 0.62);
    border-top-width: 2px;
    border-top-color: rgba(240, 240, 245, 0.95);
}

.cooldown-shade.global {
    background-color: rgba(150, 152, 162, 0.32);
    border-top-width: 1px;
    border-top-color: rgba(240, 240, 245, 0.55);
}

.action-button.counting .icon-letters {
    opacity: 0;
}

.cooldown-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 240, 200);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.xp-bar {
    width: 864px;
    height: 12px;
    margin-top: 5px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
    border-radius: 2px;
    overflow: hidden;
}

.xp-bar .bar-fill {
    background-color: rgb(140, 70, 200);
}

.xp-bar .bar-text {
    font-size: 10px;
}

/* ---------------------------------------------------------------- cast bars */

.cast-bar {
    height: 22px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 3px;
    overflow: hidden;
}

.cast-bar .bar-fill {
    background-color: rgb(226, 170, 40);
}

.cast-bar.failed .bar-fill {
    background-color: rgb(190, 40, 40);
}

.cast-bar.player {
    position: absolute;
    bottom: 190px;
    left: 50%;
    width: 360px;
    margin-left: -180px;
}

.cast-bar.small {
    height: 16px;
    margin-top: 4px;
}

/* ---------------------------------------------------------------- texts */

.error-text {
    position: absolute;
    top: 140px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 60, 50);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(30, 0, 0);
}

.notice-text {
    position: absolute;
    top: 220px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 214, 90);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(60, 36, 0);
}

/* ---------------------------------------------------------------- nameplates */

.nameplate {
    position: absolute;
    width: 140px;
    margin-left: -70px;
    align-items: center;
}

.nameplate-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    padding: 0;
    margin: 0;
}

.nameplate.hostile .nameplate-name {
    color: rgb(255, 110, 90);
}

.nameplate.neutral .nameplate-name {
    color: rgb(255, 228, 100);
}

.nameplate.player .nameplate-name {
    color: rgb(150, 200, 255);
}

.nameplate-bar {
    width: 110px;
    height: 7px;
    margin-top: 1px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.9);
}

.nameplate-bar .bar-fill {
    background-color: rgb(46, 170, 66);
}

.nameplate.hostile .nameplate-bar .bar-fill {
    background-color: rgb(200, 40, 34);
}

.nameplate.neutral .nameplate-bar .bar-fill {
    background-color: rgb(210, 180, 40);
}

.nameplate.targeted .nameplate-name {
    font-size: 15px;
}

.nameplate.targeted .nameplate-bar {
    border-color: rgb(255, 255, 255);
}

.nameplate.dead {
    opacity: 0.5;
}

.nameplate-cast {
    width: 110px;
    height: 6px;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0.7);
}

.nameplate-cast .bar-fill {
    background-color: rgb(226, 170, 40);
}

/* ---------------------------------------------------------------- floating combat text */

.fct {
    position: absolute;
    width: 200px;
    margin-left: -100px;
    -unity-text-align: middle-center;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.fct.crit {
    font-size: 36px;
    color: rgb(255, 220, 60);
}

.fct.taken {
    color: rgb(255, 70, 60);
}

.fct.heal {
    color: rgb(90, 240, 100);
}

.fct.miss {
    font-size: 20px;
    color: rgb(200, 200, 210);
}

.fct.xp {
    font-size: 20px;
    color: rgb(190, 130, 255);
}

.fct.spell {
    color: rgb(255, 240, 150);
}

/* ---------------------------------------------------------------- chat */

.chat {
    position: absolute;
    left: 18px;
    bottom: 120px;
    width: 560px;
}

.chat-log {
    justify-content: flex-end;
}

.chat-line {
    font-size: 16px;
    color: rgb(245, 245, 245);
    white-space: normal;
    align-self: flex-start;
    padding: 1px 6px;
    margin: 1px 0;
    background-color: rgba(0, 0, 0, 0.62);
    border-radius: 3px;
}

.chat-line.system {
    color: rgb(255, 230, 120);
}

.chat-line.combat {
    color: rgb(180, 180, 255);
}

.chat-input {
    margin-top: 4px;
}

.chat-input .unity-base-text-field__input {
    font-size: 15px;
    background-color: rgba(0, 0, 0, 0.75);
    color: rgb(255, 255, 255);
}

/* ---------------------------------------------------------------- tooltip and death */

.tooltip {
    position: absolute;
    width: 320px;
    padding: 10px;
    background-color: rgba(10, 14, 24, 0.95);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 5px;
}

.tooltip-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.tooltip-meta {
    font-size: 13px;
    color: rgb(200, 200, 210);
    white-space: normal;
}

.tooltip-body {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(255, 214, 90);
    white-space: normal;
}

.death-panel {
    position: absolute;
    top: 300px;
    left: 50%;
    width: 360px;
    margin-left: -180px;
    padding: 20px;
    align-items: center;
    background-color: rgba(14, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgb(122, 98, 48);
    border-radius: 8px;
}
