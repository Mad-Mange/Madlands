<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Madlands.uss" />
    <Style src="Hud.uss" />
    <Style src="Windows.uss" />
    <ui:VisualElement name="root" class="root frontend" picking-mode="Ignore">

        <!-- In-game HUD (HudController). Lowest layer: menus and overlays draw on top of it. -->
        <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
            <ui:VisualElement name="nameplates" class="layer" picking-mode="Ignore" />
            <ui:VisualElement name="combat-text" class="layer" picking-mode="Ignore" />

            <ui:VisualElement name="player-frame" class="unit-frame player" picking-mode="Ignore">
                <ui:VisualElement class="portrait" picking-mode="Ignore">
                    <ui:Label name="player-level" class="portrait-level" />
                </ui:VisualElement>
                <ui:VisualElement class="frame-body" picking-mode="Ignore">
                    <ui:Label name="player-name" class="frame-name" />
                    <ui:VisualElement class="bar health" picking-mode="Ignore">
                        <ui:VisualElement name="player-health-fill" class="bar-fill" picking-mode="Ignore" />
                        <ui:Label name="player-health-text" class="bar-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="player-power" class="bar power" picking-mode="Ignore">
                        <ui:VisualElement name="player-power-fill" class="bar-fill" picking-mode="Ignore" />
                        <ui:Label name="player-power-text" class="bar-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="player-stamina" class="stamina-bar full" picking-mode="Ignore">
                    <ui:VisualElement name="player-stamina-fill" class="bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="target-frame" class="unit-frame target hidden" picking-mode="Ignore">
                <ui:VisualElement class="portrait" picking-mode="Ignore">
                    <ui:Label name="target-level" class="portrait-level" />
                </ui:VisualElement>
                <ui:VisualElement class="frame-body" picking-mode="Ignore">
                    <ui:Label name="target-name" class="frame-name" />
                    <ui:VisualElement class="bar health" picking-mode="Ignore">
                        <ui:VisualElement name="target-health-fill" class="bar-fill" picking-mode="Ignore" />
                        <ui:Label name="target-health-text" class="bar-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="target-power" class="bar power" picking-mode="Ignore">
                        <ui:VisualElement name="target-power-fill" class="bar-fill" picking-mode="Ignore" />
                        <ui:Label name="target-power-text" class="bar-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="target-auras" class="aura-row" picking-mode="Ignore" />
                    <ui:VisualElement name="target-cast" class="cast-bar small hidden" picking-mode="Ignore">
                        <ui:VisualElement name="target-cast-fill" class="bar-fill" picking-mode="Ignore" />
                        <ui:Label name="target-cast-text" class="bar-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="player-auras" class="player-auras" picking-mode="Ignore" />

            <ui:Label name="error-text" class="error-text" />
            <ui:Label name="notice-text" class="notice-text" />

            <ui:VisualElement name="player-cast" class="cast-bar player hidden" picking-mode="Ignore">
                <ui:VisualElement name="player-cast-fill" class="bar-fill" picking-mode="Ignore" />
                <ui:Label name="player-cast-text" class="bar-text" />
            </ui:VisualElement>

            <ui:VisualElement name="bottom-bar" class="bottom-bar" picking-mode="Ignore">
                <ui:VisualElement name="action-bar" class="action-bar" picking-mode="Ignore" />
                <ui:VisualElement name="xp-bar" class="xp-bar" picking-mode="Ignore">
                    <ui:VisualElement name="xp-fill" class="bar-fill" picking-mode="Ignore" />
                    <ui:Label name="xp-text" class="bar-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="chat" class="chat" picking-mode="Ignore">
                <ui:VisualElement name="chat-log" class="chat-log" picking-mode="Ignore" />
                <ui:TextField name="chat-input" max-length="200" class="chat-input hidden" />
            </ui:VisualElement>

            <ui:VisualElement name="tooltip" class="tooltip hidden" picking-mode="Ignore">
                <ui:Label name="tooltip-title" class="tooltip-title" />
                <ui:Label name="tooltip-meta" class="tooltip-meta" />
                <ui:Label name="tooltip-body" class="tooltip-body" />
            </ui:VisualElement>

            <ui:VisualElement name="death-panel" class="death-panel hidden">
                <ui:Label text="#hud.died" class="heading" />
                <ui:Button name="release-button" text="#hud.release" class="button primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Login -->
        <ui:VisualElement name="login-screen" class="screen" picking-mode="Ignore">
            <ui:VisualElement class="brand" picking-mode="Ignore">
                <ui:Label text="MADLANDS" class="brand-title" />
                <ui:Label text="#login.tagline" class="brand-tagline" />
            </ui:VisualElement>
            <ui:VisualElement class="panel">
                <ui:TextField name="login-username" label="#login.account" max-length="32" class="field" />
                <ui:TextField name="login-password" label="#login.password" password="true" max-length="128" class="field" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="login-button" text="#login.logIn" class="button primary" />
                    <ui:Button name="register-button" text="#login.createAccount" class="button" />
                </ui:VisualElement>
                <ui:Button name="quick-login-button" text="#login.quick" class="button quick hidden" />
                <ui:Label name="login-status" class="status" />
            </ui:VisualElement>
            <ui:VisualElement class="footer" picking-mode="Ignore">
                <ui:TextField name="login-server" label="#login.server" class="field small" />
                <ui:VisualElement class="footer-right" picking-mode="Ignore">
                    <ui:Button name="login-settings-button" text="#common.settings" class="button" />
                    <ui:Label name="version-label" class="version" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Character select -->
        <ui:VisualElement name="characters-screen" class="screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="panel wide">
                <ui:Label text="#characters.title" class="heading" />
                <ui:Label name="realm-label" class="subheading" />
                <ui:ScrollView name="character-list" class="character-list" />
                <ui:Label name="characters-empty" text="#characters.empty" class="hint" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="enter-world-button" text="#characters.enter" class="button primary" />
                    <ui:Button name="create-new-button" text="#characters.createNew" class="button" />
                    <ui:Button name="delete-button" text="#characters.delete" class="button danger" />
                    <ui:Button name="logout-button" text="#common.logOut" class="button" />
                </ui:VisualElement>
                <ui:Label name="characters-status" class="status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Create character -->
        <ui:VisualElement name="create-screen" class="screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="panel">
                <ui:Label text="#create.title" class="heading" />
                <ui:TextField name="create-name" label="#create.name" max-length="16" class="field" />
                <ui:DropdownField name="create-race" label="#create.race" class="field" />
                <ui:DropdownField name="create-class" label="#create.class" class="field" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="create-button" text="#create.create" class="button primary" />
                    <ui:Button name="create-cancel-button" text="#create.back" class="button" />
                </ui:VisualElement>
                <ui:Label name="create-status" class="status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Busy overlay (blocks input while a request is running) -->
        <ui:VisualElement name="busy-overlay" class="overlay hidden">
            <ui:Label name="busy-label" text="#common.wait" class="busy-label" />
        </ui:VisualElement>

        <!-- In-game menu (Esc) -->
        <ui:VisualElement name="game-menu" class="overlay hidden">
            <ui:VisualElement class="panel narrow">
                <ui:Label text="#menu.title" class="heading" />
                <ui:Button name="menu-resume-button" text="#menu.resume" class="button primary" />
                <ui:Button name="menu-settings-button" text="#common.settings" class="button" />
                <ui:Button name="menu-logout-button" text="#common.logOut" class="button" />
                <ui:Button name="menu-quit-button" text="#menu.exit" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
