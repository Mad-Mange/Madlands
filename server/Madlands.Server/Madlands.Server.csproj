<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel for the HTTP account API, hosted in the same process as the game loop. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Madlands.Shared\Madlands.Shared.csproj" />
    <ProjectReference Include="..\Madlands.Content\Madlands.Content.csproj" />
    <ProjectReference Include="..\Madlands.Navigation\Madlands.Navigation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep LiteNetLib in sync with shared/Madlands.ClientCore/Madlands.ClientCore.csproj -->
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL migrations, applied in name order by DbUp (PostgresGameDatabase.Open). -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Madlands.Server.Tests" />
  </ItemGroup>

</Project>
