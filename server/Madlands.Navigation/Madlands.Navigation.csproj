<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Server-side world geometry: navmesh (DotRecast, zlib license) built from a map's height map +
    exported static colliders, and line-of-sight ray casts. Engine-free; used by the server and tools.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Madlands.Shared\Madlands.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Core" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Detour" Version="2026.3.1" />
  </ItemGroup>

</Project>
