{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madlands.local/schemas/loot.schema.json",
  "title": "Loot tables (content/loot.json)",
  "description": "What creatures drop. Rolled for the player who tapped the creature. Quest items only drop for players who still need them.",
  "type": "object",
  "required": [
    "lootTables"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lootTables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Creatures refer to it by this id."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "money": {
            "type": "object",
            "additionalProperties": false,
            "description": "Copper, rolled uniformly.",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "items": {
            "type": "array",
            "description": "Each rolls on its own.",
            "items": {
              "type": "object",
              "required": [
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "item": {
                  "type": "integer",
                  "minimum": 1
                },
                "chance": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "default": 1
                },
                "min": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                }
              }
            }
          },
          "groups": {
            "type": "array",
            "description": "With its chance, exactly one of the items drops (each equally likely).",
            "items": {
              "type": "object",
              "required": [
                "chance",
                "items"
              ],
              "additionalProperties": false,
              "properties": {
                "chance": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
