{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madlands.local/schemas/classes.schema.json",
  "title": "Playable classes (content/classes.json)",
  "type": "object",
  "required": ["classes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 255, "description": "Stable id stored on characters. Never reuse." },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
