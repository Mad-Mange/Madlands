{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madlands.local/schemas/factions.schema.json",
  "title": "Factions (content/factions.json)",
  "description": "Same faction = friendly; hostile if either side lists the other as hostile; friendly if either lists it as friendly; else neutral.",
  "type": "object",
  "required": [
    "factions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Stable id. Never reuse."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "friendly": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "hostile": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
