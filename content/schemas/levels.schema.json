{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://madlands.local/schemas/levels.schema.json",
  "title": "Experience table (content/levels.json)",
  "type": "object",
  "required": [
    "maxLevel",
    "xpToNextLevel"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "maxLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "xpToNextLevel": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "One entry per level below the cap."
    },
    "rest": {
      "type": "object",
      "description": "Rested experience: kills give double experience while the pool lasts. Percentages are of the current level's bar.",
      "additionalProperties": false,
      "properties": {
        "percentPerHour": {
          "type": "number",
          "minimum": 0,
          "default": 2.5,
          "description": "Built up per hour in a rest area (a village), logged in or out."
        },
        "elsewhereFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25,
          "description": "Logged out outside a rest area, rest builds up this much slower."
        },
        "maxPercent": {
          "type": "number",
          "minimum": 0,
          "default": 150
        }
      }
    }
  }
}
